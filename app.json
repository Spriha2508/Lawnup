{
  "expo": {
    "name": "LawnUp AI",
    "slug": "lawnup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lawnup",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAF5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lawnup.app",
      "infoPlist": {
        "NSCameraUsageDescription": "LawnUp needs camera access to scan and identify your plants.",
        "NSPhotoLibraryUsageDescription": "LawnUp needs photo library access to select plant images.",
        "NSLocationWhenInUseUsageDescription": "LawnUp uses your location to provide weather-aware plant care tips."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F8FAF5"
      },
      "package": "com.lawnup.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        { "cameraPermission": "LawnUp needs camera access to scan your plants." }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "LawnUp needs photo access to select plant images." }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2D6A4F",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": { "compileSdkVersion": 34, "targetSdkVersion": 34 },
          "ios": { "deploymentTarget": "15.1" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": { "projectId": "YOUR_EAS_PROJECT_ID" }
    }
  }
}
