{
  "expo": {
    "name": "LawnUp",
    "slug": "lawnup",
    "owner": "spriha007",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lawnup",
    "userInterfaceStyle": "light",
    "primaryColor": "#C8A24E",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0D0B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lawnup.app",
      "infoPlist": {
        "NSCameraUsageDescription": "LawnUp needs camera access to scan and identify your plants.",
        "NSPhotoLibraryUsageDescription": "LawnUp needs photo library access to select plant images.",
        "NSLocationWhenInUseUsageDescription": "LawnUp uses your location to provide weather-aware plant care tips."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ECE7E0"
      },
      "package": "com.lawnup.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "LawnUp needs camera access to scan your plants."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LawnUp needs photo access to select plant images."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C8A24E",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "openWeatherKey": "",
      "plantIdKey": "",
      "openaiKey": "",
      "eas": {
        "projectId": "75c90b84-f62b-4c99-9b64-ccc7ee9ab8e5"
      }
    }
  }
}
