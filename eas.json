{
  "cli": { "version": ">= 10.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "distribution": "internal",
      "android": { "buildType": "apk", "gradleCommand": ":app:assembleDebug" },
      "env": {
        "FIREBASE_PROJECT_ID": "lawnup-dev",
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "APP_ENV": "preview"
      }
    },
    "staging": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "FIREBASE_PROJECT_ID": "lawnup-staging",
        "APP_ENV": "staging"
      }
    },
    "production": {
      "distribution": "store",
      "android": { "buildType": "aab" },
      "env": {
        "FIREBASE_PROJECT_ID": "lawnup-prod",
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
