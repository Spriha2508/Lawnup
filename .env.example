# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Firebase (JS SDK — client-safe config, NOT secret)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# PostHog (public write key — safe to expose)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ImageKit (public ID — safe to expose)
EXPO_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_ID

# App environment
EXPO_PUBLIC_APP_ENV=development

# Backend (Firebase Functions). Leave false/unset for client-side internal-testing:
# the app then enforces usage quotas locally and makes no server-Function calls.
# Set to true ONLY once the Functions (checkUsageLimit, etc.) are deployed.
EXPO_PUBLIC_BACKEND_ENABLED=false

# OpenWeather (client-side for MVP — free-tier key, low exposure risk)
EXPO_PUBLIC_OPENWEATHER_KEY=

# ---- Launch integrations (set at the native-setup stage) ----
# RevenueCat Android public SDK key (see docs/revenuecat-setup.md)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Google Sign-In: OAuth **Web** client ID (see docs/google-signin-setup.md)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Sentry DSN (see docs/sentry-setup.md)
EXPO_PUBLIC_SENTRY_DSN=

# ---- BACKEND ONLY — Firebase Functions secrets (NEVER prefix with EXPO_PUBLIC_) ----
# EXPO_PUBLIC_* vars are inlined into the app bundle, so paid/secret keys must
# never use that prefix. Set these as Functions secrets, not in this file:
#   firebase functions:secrets:set PLANT_ID_KEY
#   firebase functions:secrets:set OPENAI_KEY
#   firebase functions:secrets:set OPENWEATHER_KEY        # used by AI chat + fetchWeather
# Parked (web checkout, not deployed at launch — RevenueCat handles in-app):
#   firebase functions:secrets:set CASHFREE_APP_ID
#   firebase functions:secrets:set CASHFREE_SECRET_KEY
#   firebase functions:secrets:set CASHFREE_WEBHOOK_SECRET
