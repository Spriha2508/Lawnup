# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Firebase (JS SDK — client-safe config, NOT secret)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# PostHog (public write key — safe to expose)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ImageKit (public ID — safe to expose)
EXPO_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_ID

# App environment
EXPO_PUBLIC_APP_ENV=development

# Cashfree (public app ID — safe to expose)
EXPO_PUBLIC_CASHFREE_APP_ID=

# ---- BACKEND ONLY (Firebase Functions config, never in client) ----
# firebase functions:config:set openai.key="sk-..."
# firebase functions:config:set plantid.key="..."
# firebase functions:config:set cashfree.app_id="..."
# firebase functions:config:set cashfree.secret_key="..."
# firebase functions:config:set cashfree.webhook_secret="..."
# firebase functions:config:set openweather.key="..."
# firebase functions:config:set firebase.project_id="your_project_id"
