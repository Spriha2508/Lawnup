#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  LawnUp — start
#  Launches Expo with a public tunnel, then opens a browser page with the QR
#  code ready to scan with Expo Go.
#
#  Usage:  ./start
#  Stop:   ./stop
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_FILE="$SCRIPT_DIR/logs/tunnel.log"
PID_FILE="/tmp/lawnup.pid"
HTML_FILE="/tmp/lawnup_qr.html"

# ── Colours ──────────────────────────────────────────────────────────────────
GRN='\033[0;32m' YLW='\033[1;33m' RED='\033[0;31m'
CYN='\033[0;36m' BLD='\033[1m'    DIM='\033[2m'    NC='\033[0m'

say()  { printf "${CYN}${BLD}▸${NC}  %s\n"          "$*"; }
ok()   { printf "${GRN}${BLD}✓${NC}  %s\n"          "$*"; }
warn() { printf "${YLW}${BLD}!${NC}  %s\n"          "$*"; }
die()  { printf "${RED}${BLD}✗${NC}  %s\n" "$*"; exit 1; }

# ── Banner ───────────────────────────────────────────────────────────────────
echo ""
printf "${GRN}${BLD}"
echo   "  ╔══════════════════════════════════════╗"
echo   "  ║   🌿  LawnUp — Expo Dev Launcher    ║"
printf "  ╚══════════════════════════════════════╝${NC}\n"
echo ""

# ── Prerequisites ─────────────────────────────────────────────────────────────
[[ -f "$SCRIPT_DIR/package.json" ]] || die "Run this from the project root."
command -v node &>/dev/null          || die "node not found."
command -v npx  &>/dev/null          || die "npx not found."
[[ -d "$SCRIPT_DIR/node_modules" ]]  || {
  say "node_modules missing — running npm install..."
  npm install --prefix "$SCRIPT_DIR" || die "npm install failed."
}

# ── Kill any existing session ─────────────────────────────────────────────────
say "Stopping any existing LawnUp dev session..."
if [[ -f "$PID_FILE" ]]; then
  OLD_PID=$(cat "$PID_FILE" 2>/dev/null || true)
  [[ -n "$OLD_PID" ]] && kill -TERM "$OLD_PID" 2>/dev/null || true
  rm -f "$PID_FILE"
fi
pkill -f "expo start"  2>/dev/null || true
pkill -f "ngrok start" 2>/dev/null || true
sleep 1

# ── Start Expo with tunnel ────────────────────────────────────────────────────
mkdir -p "$SCRIPT_DIR/logs"
: > "$LOG_FILE"          # truncate/create log

say "Starting Expo tunnel (this takes ~30 s on first run)..."

# Spawn expo; tee to log and let it print to the terminal as well
npx expo start --tunnel 2>&1 | tee "$LOG_FILE" &
EXPO_PID=$!
echo "$EXPO_PID" > "$PID_FILE"

# ── Wait for tunnel URL ───────────────────────────────────────────────────────
TUNNEL_URL=""
MAX_WAIT=120

for i in $(seq 1 $MAX_WAIT); do
  # Strip ANSI escape codes then search for exp:// URL
  TUNNEL_URL=$(
    sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' "$LOG_FILE" 2>/dev/null \
    | grep -oE 'exp://[a-zA-Z0-9._:/@%-]+' \
    | head -1
  )

  if [[ -n "$TUNNEL_URL" ]]; then
    break
  fi

  # Abort early if expo process already died
  if ! kill -0 "$EXPO_PID" 2>/dev/null; then
    die "Expo process exited unexpectedly. Check logs/tunnel.log"
  fi

  printf "\r  ${DIM}Waiting for tunnel... %ds${NC}" "$i"
  sleep 1
done
printf "\r%60s\r" ""   # clear progress line

if [[ -z "$TUNNEL_URL" ]]; then
  warn "Could not detect tunnel URL automatically after ${MAX_WAIT}s."
  warn "Check logs/tunnel.log — the server may still be starting."
  warn "You can open Expo Go and scan the QR code printed in the terminal."
  exit 0
fi

ok "Tunnel ready: $TUNNEL_URL"

# ── URL-encode the exp:// URL for the QR API ──────────────────────────────────
ENCODED_URL=$(node -e "process.stdout.write(encodeURIComponent('$TUNNEL_URL'))")

# ── Build the browser QR page ─────────────────────────────────────────────────
cat > "$HTML_FILE" << HTML
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LawnUp — Scan to open in Expo Go</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      background: #F5F1E8;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .card {
      background: #ffffff;
      border-radius: 28px;
      padding: 48px 40px 40px;
      text-align: center;
      box-shadow: 0 2px 60px rgba(0,0,0,0.07);
      max-width: 420px;
      width: 100%;
    }

    .eyebrow {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #6F943E;
      margin-bottom: 12px;
    }

    h1 {
      font-size: 26px;
      font-weight: 700;
      color: #111111;
      margin-bottom: 6px;
    }

    .sub {
      font-size: 14px;
      color: #9E9A94;
      margin-bottom: 28px;
      line-height: 1.5;
    }

    /* live indicator */
    .status {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 12px;
      font-weight: 600;
      color: #6F943E;
      background: rgba(111,148,62,0.08);
      border: 1px solid rgba(111,148,62,0.2);
      border-radius: 999px;
      padding: 6px 14px;
      margin-bottom: 24px;
    }
    .dot {
      width: 7px; height: 7px;
      background: #6F943E;
      border-radius: 50%;
      animation: blink 1.8s ease-in-out infinite;
    }
    @keyframes blink {
      0%,100% { opacity:1; transform:scale(1); }
      50%      { opacity:.35; transform:scale(.8); }
    }

    /* QR */
    .qr-frame {
      background: #F5F1E8;
      border-radius: 20px;
      padding: 20px;
      display: inline-block;
      margin-bottom: 24px;
    }
    .qr-frame img {
      display: block;
      width: 220px; height: 220px;
      border-radius: 10px;
    }

    /* URL chip */
    .url-chip {
      background: #F5F1E8;
      border-radius: 12px;
      padding: 10px 14px;
      font-size: 11.5px;
      font-family: 'SF Mono', 'Fira Code', 'Fira Mono', monospace;
      color: #6B6B5E;
      word-break: break-all;
      line-height: 1.5;
      margin-bottom: 24px;
    }

    /* instructions */
    .steps {
      font-size: 13px;
      color: #9E9A94;
      line-height: 1.8;
      text-align: left;
      background: #FAFAF8;
      border-radius: 14px;
      padding: 16px 20px;
    }
    .steps strong { color: #111; font-weight: 600; }
    .steps span { display: block; }

    .reload-note {
      margin-top: 20px;
      font-size: 11px;
      color: #C4C0BA;
    }
  </style>
</head>
<body>
  <div class="card">

    <div class="eyebrow">LawnUp AI</div>
    <h1>Scan &amp; Test</h1>
    <p class="sub">Open Expo Go on your phone, then point your camera at this QR code.</p>

    <div class="status">
      <span class="dot"></span>
      Dev server live
    </div>

    <div class="qr-frame">
      <img
        src="https://api.qrserver.com/v1/create-qr-code/?size=440x440&data=${ENCODED_URL}&color=111111&bgcolor=F5F1E8&margin=1&qzone=2"
        alt="QR Code"
        onerror="this.alt='QR load failed — check internet connection'"
      />
    </div>

    <div class="url-chip">${TUNNEL_URL}</div>

    <div class="steps">
      <span><strong>Android</strong> — Open Expo Go → tap <em>Scan QR code</em></span>
      <span><strong>iOS</strong> — Open the native Camera app → point at code</span>
    </div>

    <p class="reload-note">This page does not auto-refresh. Re-run ./start to get a new URL after each restart.</p>

  </div>
</body>
</html>
HTML

# ── Open in browser ───────────────────────────────────────────────────────────
open "$HTML_FILE"

echo ""
ok "Browser opened with QR code — scan it in Expo Go."
say "Expo output is streaming to your terminal above and to logs/tunnel.log"
say "Run ${BLD}./stop${NC} to shut everything down."
echo ""
